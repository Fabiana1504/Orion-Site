# Archivo: .env.example
# Responsabilidad: plantilla de variables de entorno para desarrollo local seguro.
# Se copia a .env.local y ahí se rellenan claves reales.

# Copiá a .env.local (no subir claves al repo).

# Supabase (front): URL + anon key. Sin esto, el laboratorio solo usa análisis local y localStorage.
# SQL inicial: database/schema.sql (legacy telemetry_runs)
# Telemetría normalizada: database/migrations/002_normalized_telemetry.sql
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Login local opcional para el laboratorio (sin depender de Supabase Auth).
# Si defines ambos valores, esas credenciales también serán válidas en /equipo/laboratorio.
VITE_LAB_LOGIN_USER=
VITE_LAB_LOGIN_PASSWORD=

# Lista opcional de correos permitidos para entrar al laboratorio (separados por coma).
# Ejemplo: VITE_LAB_ALLOWED_EMAILS=correo1@dominio.com,correo2@dominio.com
VITE_LAB_ALLOWED_EMAILS=

# OpenAI NO va en el navegador. Configurá en Supabase → Edge Functions → Secrets:
#   OPENAI_API_KEY
#   OPENAI_MODEL   (opcional, default gpt-4o-mini)
# Para ingest Arduino opcional:
#   DEVICE_INGEST_SECRET  (≥8 caracteres)
